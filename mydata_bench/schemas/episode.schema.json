{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rewardbench/episode/1.0.0",
  "type": "object",
  "required": ["schema_version", "example_id", "video_path", "task", "reward", "subset", "video_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "example_id": {"type": "string", "minLength": 1},
    "video_path": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "reward": {"type": "integer", "minimum": 1, "maximum": 5},
    "subset": {"type": "string", "minLength": 1},
    "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

