{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rewardbench/grounding/1.0.0",
  "type": "object",
  "required": ["schema_version", "example_id", "video_sha256", "backend", "query", "frame", "bbox", "score", "audit_status", "provenance", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "example_id": {"type": "string", "minLength": 1},
    "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backend": {"enum": ["grounding_dino", "sam3"]},
    "query": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "frame": {"enum": ["first", "last"]},
    "bbox": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
      ]
    },
    "score": {"type": ["number", "null"]},
    "audit_status": {"type": "string"},
    "provenance": {"type": "object"},
    "status": {"type": "string"}
  }
}

