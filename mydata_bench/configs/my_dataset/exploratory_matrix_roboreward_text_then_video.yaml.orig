my_dataset_exploratory_matrix:
  variant_id: roboreward_8b_native_front_text_then_video_matrix
  model_family: roboreward
  model_path: /mnt/public1/dais/workspace/model/RoboReward-8B
  ranking_manifest: /mnt/public1/dais/workspace/Robo-Dopamine/mydata_bench/artifacts/my_dataset/ljx_lfz_cf_v1/ranking_cohort/roboreward/ordered_max20.jsonl
  evaluation_manifest: /mnt/public1/dais/workspace/Robo-Dopamine/mydata_bench/artifacts/my_dataset/ljx_lfz_cf_v1/attention_assumed/roboreward/all.jsonl
  output_dir: /mnt/public1/dais/workspace/Robo-Dopamine/mydata_bench/outputs/my_dataset/ljx_lfz_cf_v1/exploratory_matrix/roboreward_8b_native_front_text_then_video

  protocol: roborewardbench_native
  content_order: text_then_video
  attention_video_max_frames: 8
  ranking_prefix_sizes: [5, 10, 20]
  steering_top_k: [8, 32, 64]
  ranking_score_kind: excess_mass
  skip_early_layers: 8
  swap_bias: 6
  steering_query_scope: all
  expected_ranking_count: 20
  expected_evaluation_count: 755
  capture_generation_attentions: false

  torch_dtype: bfloat16
  device_map: auto
  max_new_tokens: 32
