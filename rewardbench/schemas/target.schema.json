{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rewardbench/target/1.0.0",
  "type": "object",
  "required": ["schema_version", "example_id", "target_phrase", "head_noun", "entity_type", "multi_target", "ambiguous", "parser_fingerprint"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "example_id": {"type": "string", "minLength": 1},
    "target_phrase": {"type": "string", "minLength": 1},
    "head_noun": {"type": "string", "minLength": 1},
    "attributes": {"type": "array", "items": {"type": "string"}},
    "entity_type": {"enum": ["object", "object_part", "robot_part", "spatial_region", "unknown"]},
    "multi_target": {"type": "boolean"},
    "ambiguous": {"type": "boolean"},
    "parser_fingerprint": {"type": "string", "minLength": 1}
  }
}

